# ============================================================
# quiz-publish-bot — Environment Variables
# ============================================================
# ⚠️  NEVER commit this file with real values.
#     Store secrets in Cloudflare Worker Environment Variables:
#     Dashboard → Workers & Pages → quiz-publish-bot → Settings → Variables
# ============================================================

# Telegram Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# OpenAI API key (used for essay grading)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# GitHub Personal Access Token (repo scope)
# https://github.com/settings/tokens → Generate new token (classic) → check "repo"
# ⚠️  This token grants write access to your blog repo. Keep it secret.
GITHUB_TOKEN=

# Your blog repository in "username/repo-name" format
# e.g. john/my-blog
GITHUB_REPO=
